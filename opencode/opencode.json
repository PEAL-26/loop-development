{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "loop-development": {
      "permission": {
        "task": {
          "*": "deny",
          "intake": "allow",
          "grill-me": "allow",
          "researcher": "allow",
          "planner": "allow",
          "planner-writer": "allow",
          "architecture-reviewer": "allow",
