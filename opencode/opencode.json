{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "loop-development": {
      "permission": {
        "task": {
          "*": "deny",
          "intake": "allow",
          "grill-me": "allow",
          "researcher": "allow",
          "planner": "allow",
          "planner-writer": "allow",
          "architecture-reviewer": "allow",
          "task-generator": "allow",
          "dependency-auditor": "allow",
          "context-loader": "allow",
          "implementer": "allow",
          "refactorer": "allow",
          "test-writer": "allow",
          "verifier": "allow",
          "security-auditor": "allow",
          "performance-auditor": "allow",
          "documentation-writer": "allow",
          "git-manager": "allow",
          "state-manager": "allow",
          "compacter": "allow",
          "final-reviewer": "allow"
        },
        "read": { ".loop-development/**": "allow" },
        "edit": { ".loop-development/**": "allow" },
        "glob": { ".loop-development/**": "allow" }
      }
    },
    "context-loader": {
      "permission": {
        "read": { ".loop-development/**": "allow" },
        "edit": { ".loop-development/**": "allow" },
        "glob": { ".loop-development/**": "allow" }
      }
    },
    "state-manager": {
      "permission": {
        "read": { ".loop-development/**": "allow" },
        "edit": { ".loop-development/**": "allow" },
        "glob": { ".loop-development/**": "allow" }
      }
    },
    "planner-writer": {
      "permission": {
        "read": { ".loop-development/**": "allow" },
        "edit": { ".loop-development/**": "allow" },
        "glob": { ".loop-development/**": "allow" }
      }
    },
    "task-generator": {
      "permission": {
        "read": { ".loop-development/**": "allow" },
        "edit": { ".loop-development/**": "allow" },
        "glob": { ".loop-development/**": "allow" }
      }
    },
    "compacter": {
      "permission": {
        "read": { ".loop-development/**": "allow" },
        "edit": { ".loop-development/**": "allow" },
        "glob": { ".loop-development/**": "allow" }
      }
    },
    "refactorer": {
      "permission": {
        "read": { ".loop-development/**": "allow" },
        "edit": { ".loop-development/**": "allow" },
        "glob": { ".loop-development/**": "allow" }
      }
    },
    "implementer": {
      "permission": {
        "read": { ".loop-development/**": "allow" },
        "glob": { ".loop-development/**": "allow" }
      }
    },
    "test-writer": {
      "permission": {
        "read": { ".loop-development/**": "allow" },
        "glob": { ".loop-development/**": "allow" }
      }
    },
    "git-manager": {
      "permission": {
        "read": { ".loop-development/**": "allow" },
        "glob": { ".loop-development/**": "allow" }
      }
    },
    "documentation-writer": {
      "permission": {
        "read": { ".loop-development/**": "allow" },
        "edit": { ".loop-development/**": "allow" },
        "glob": { ".loop-development/**": "allow" }
      }
    },
    "final-reviewer": {
      "permission": {
        "read": { ".loop-development/**": "allow" },
        "edit": { ".loop-development/**": "allow" },
        "glob": { ".loop-development/**": "allow" }
      }
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "git checkout*": "ask",
      "git switch*": "ask",
      "git rebase*": "ask",
      "git merge*": "ask",
      "git branch -D*": "ask",
      "git stash drop*": "ask",
      "rm *": "ask",
      "rmdir *": "ask",
      "unlink *": "ask",
      "truncate *": "ask",
      "sudo *": "ask",
      "shutdown*": "ask",
      "reboot*": "ask",
      "poweroff*": "ask",
      "kill -9*": "ask",
      "pkill *": "ask",
      "killall *": "ask",
      "dd *": "ask",
      "mkfs*": "ask",
      "fdisk*": "ask",
      "npm uninstall*": "ask",
      "yarn remove*": "ask",
      "pnpm remove*": "ask",
      "bun remove*": "ask",
      "pip uninstall*": "ask",
      "docker rm*": "ask",
      "docker rmi*": "ask",
      "docker system prune*": "ask",
      "docker volume rm*": "ask",
      "docker compose down*": "ask",
      "terraform destroy*": "ask",
      "tofu destroy*": "ask"
    }
  }
}
